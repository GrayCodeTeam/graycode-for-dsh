    },
    {
      "id": "F14k",
      "dir": "F14k-scope-corrupt",
      "target": "memory-workspaces/<hash>/scope.json",
      "damage": "非法 JSON `{broken`",
      "expected": "该工作区目录跳过（不视为 scope）；健康工作区照常导入"
    },
    {
      "id": "F14l",
      "dir": "F14l-empty-files-array",
